# Ключи сервисов. Скопируй этот файл в .env (установщик делает это сам) и впиши ключи после «=».
# Pixabay (бесплатно, сток по умолчанию): pixabay.com/api/docs — стоковые видео и фото для вставок.
PIXABAY_API_KEY=
# Pexels (бесплатно, только если попросишь искать там): pexels.com/api
PEXELS_API_KEY=
